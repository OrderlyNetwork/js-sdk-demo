{
  "name": "orderly-js-sdk-vite-template",
  "description": "Template for Orderly SDK v2 based on Vite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm start:staging",
    "start:dev": "vite --mode dev --port 4564",
    "start:qa": "vite --mode qa --port 4565",
    "start:staging": "vite --mode staging --port 4567",
    "start:prod": "vite --mode prod --port 4568",
    "build": "tsc --noEmit &&NODE_OPTIONS=--max_old_space_size=7168 vite build",
    "start": "vite preview",
    "preview": "vite preview",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run && sh tests/entrypoint.test.sh",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "prepare": "husky",
    "release:dev:demo": "VITE_APP_TARGET=demo orderly-release-tag --env dev",
    "release:dev:dmm": "VITE_APP_TARGET=dmm orderly-release-tag --env dev",
    "release:qa:demo": "VITE_APP_TARGET=demo orderly-release-tag --env qa",
    "release:qa:dmm": "VITE_APP_TARGET=dmm orderly-release-tag --env qa",
    "release:app:demo": "VITE_APP_TARGET=demo orderly-release-tag --env app",
    "release:app:dmm": "VITE_APP_TARGET=dmm orderly-release-tag --env app",
    "release:prod:demo": "VITE_APP_TARGET=demo orderly-release-tag --env prod",
    "release:prod:dmm": "VITE_APP_TARGET=dmm orderly-release-tag --env prod",
    "release:dev": "pnpm release:dev:demo && pnpm release:dev:dmm",
    "release:qa": "pnpm release:qa:demo && pnpm release:qa:dmm",
    "release:app": "pnpm release:app:demo && pnpm release:app:dmm",
    "release:prod": "pnpm release:prod:demo && pnpm release:prod:dmm",
    "updateSdkVersion": "node scripts/updateSdkVersion.js"
  },
  "dependencies": {
    "@orderly.network/affiliate": "3.2.2-internal-visual.0",
    "@orderly.network/core": "3.2.2-internal-visual.0",
    "@orderly.network/fast-place-order-plugin": "^0.2.4",
    "@orderly.network/hooks": "3.2.2-internal-visual.0",
    "@orderly.network/i18n": "3.2.2-internal-visual.0",
    "@orderly.network/markets": "3.2.2-internal-visual.0",
    "@orderly.network/onramper-plugin": "^0.3.1",
    "@orderly.network/portfolio": "3.2.2-internal-visual.0",
    "@orderly.network/react-app": "3.2.2-internal-visual.0",
    "@orderly.network/trading": "3.2.2-internal-visual.0",
    "@orderly.network/trading-leaderboard": "3.2.2-internal-visual.0",
    "@orderly.network/trading-rewards": "3.2.2-internal-visual.0",
    "@orderly.network/types": "3.2.2-internal-visual.0",
    "@orderly.network/ui": "3.2.2-internal-visual.0",
    "@orderly.network/ui-notification": "3.2.2-internal-visual.0",
    "@orderly.network/ui-scaffold": "3.2.2-internal-visual.0",
    "@orderly.network/vaults": "3.2.2-internal-visual.0",
    "@orderly.network/wallet-connector": "3.2.2-internal-visual.0",
    "@orderly.network/wallet-connector-privy": "3.2.2-internal-visual.0",
    "@solana-mobile/wallet-adapter-mobile": "^2.1.4",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-wallets": "^0.19.38",
    "@solana/web3.js": "^1.95.3",
    "@sentry/react": "^10.67.0",
    "@web3-onboard/injected-wallets": "2.11.3",
    "@web3-onboard/walletconnect": "2.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@orderly.network/release-tag": "^1.0.6",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^20.19.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@sentry/vite-plugin": "^5.4.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "postcss": "^8.5.26",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.6",
    "typescript": "^5",
    "typescript-eslint": "^8.60.1",
    "vite": "^7.0.4",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "@coinbase/cdp-sdk>axios": "1.18.0",
      "@ethersproject/providers>ws": "8.21.0",
      "@json-rpc-tools/provider>axios": "0.33.0",
      "@solana/wallet-adapter-walletconnect>@walletconnect/solana-adapter": "0.0.9",
      "@trezor/protobuf>protobufjs": "7.6.5",
      "@web3-onboard/core>nanoid": "5.1.16",
      "bnc-sdk>crypto-es": "2.1.0",
      "viem@2.12.0>ws": "8.21.0",
      "viem@2.23.2>ws": "8.21.0",
      "viem@2.31.0>ws": "8.21.0",
      "viem@2.52.2>ws": "8.21.0"
    }
  }
}
